{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Test Explorer (unittests)",
            "type": "debugpy",
            "request": "launch",
            "purpose" : [ "debug-test" ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${env:HOME}/VSCodeWorkspaces/video_captioning/src/:${env:PYTHONPATH}"
            },
            "cwd": "${workspaceFolder}/src",
            "justMyCode" : false,
            "logToFile"  : true,
        },
        {
            "name": "Python: Cytoscape Barn prep Debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/result_analysis/chirp_cytoscape.py",
            "console": "integratedTerminal",
            "args": [
                "--infile", "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures.csv", 
                "--clusterstats", "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/chirp_prediction_confidence_measures.csv",
                "--k", "9",
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: Cytoscape Lake prep Debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/result_analysis/chirp_cytoscape.py",
            "console": "integratedTerminal",
            "args": [
                "--infile", "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_lake_2secs_myca_quantile_1_28/all_chirp_measures.csv",
                "--clusterstats", "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_lake_2secs_myca_quantile_1_28/chirp_prediction_confidence_measures.csv",
                "--k", "9",
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: Basic chart Bar ",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/result_analysis/basic_charting.py",
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures_augmented.csv", 
                "bar",
                "cluster",
                "is_first", "is_last",
                "--title", "Cluster first/last in sequence",
                "--xlabel", "Cluster ID",
                "--ylabel", "Frequency",
                "--outfile", "${env:HOME}/VSCodeWorkspaces/bats/src/result_analysis/data/AnalysisViz/cluster_firsts_and_lasts_barchart.png"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: Normality via histogram no clusters",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/result_analysis/bat_measures_normality.py",
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures_augmented.csv", 
                "vizcurve",
                "--cols", "HiFreq", "Bndwdth"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: Normality via histogram clustered",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/result_analysis/bat_measures_normality.py",
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures_augmented.csv", 
                "vizcurve",
                "--clustered",
                "--cols", "HiFreq", "Bndwdth"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: Normality shapiro-wilk check clustered",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/result_analysis/bat_measures_normality.py",
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures_augmented.csv", 
                "shapiro",
                "--clustered",
                "--cols", "HiFreq", "Bndwdth"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: Normality shapiro-wilk no clusters",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/result_analysis/bat_measures_normality.py",
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures_augmented.csv", 
                "shapiro",
                "--cols", "HiFreq", "Bndwdth"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: Normality in clusters matrix",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/result_analysis/charting.py",
            "console": "integratedTerminal",
            "args": [
                "--normality_in_clusters",
                "${workspaceFolder}/src/result_analysis/data/bats_measures_normality_all.csv", 
                "--outdir", "${workspaceFolder}/src/result_analysis/data/AnalysisViz"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: Measure importance (KW and Random Forest",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/result_analysis/measures_in_clusters.py",
            "subProcess": false,
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures.csv",
                "--cols", "HiFreq", "Bndwdth",
                "--force"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
    ],
    "debug.defaultConfiguration": "Python: Test Explorer (unittests)"
}
