{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Test Explorer (unittests)",
            "type": "debugpy",
            "request": "launch",
            "purpose" : [ "debug-test" ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${env:HOME}/VSCodeWorkspaces/video_captioning/src/:${env:PYTHONPATH}"
            },
            "cwd": "${workspaceFolder}/src",
            "justMyCode" : false,
            "logToFile"  : true,
        },
        {
            "name": "Python: Cytoscape Barn prep Debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/result_analysis/chirp_cytoscape.py",
            "console": "integratedTerminal",
            "args": [
                "--infile", "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures.csv", 
                "--clusterstats", "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/chirp_prediction_confidence_measures.csv",
                "--k", "9",
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: Cytoscape Lake prep Debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/result_analysis/chirp_cytoscape.py",
            "console": "integratedTerminal",
            "args": [
                "--infile", "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_lake_2secs_myca_quantile_1_28/all_chirp_measures.csv",
                "--clusterstats", "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_lake_2secs_myca_quantile_1_28/chirp_prediction_confidence_measures.csv",
                "--k", "9",
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: Basic chart Bar ",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/result_analysis/basic_charting.py",
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures_augmented.csv", 
                "bar",
                "cluster",
                "is_first", "is_last",
                "--title", "Cluster first/last in sequence",
                "--xlabel", "Cluster ID",
                "--ylabel", "Frequency",
                "--outfile", "${env:HOME}/VSCodeWorkspaces/bats/src/result_analysis/data/AnalysisViz/cluster_firsts_and_lasts_barchart.png"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: Normality via histogram no clusters",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/result_analysis/bat_measures_normality.py",
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures_augmented.csv", 
                "vizcurve",
                "--cols", "HiFreq", "Bndwdth"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: Normality via histogram clustered",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/result_analysis/bat_measures_normality.py",
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures_augmented.csv", 
                "vizcurve",
                "--clustered",
                "--cols", "HiFreq", "Bndwdth"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: Normality shapiro-wilk check clustered",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/result_analysis/bat_measures_normality.py",
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures_augmented.csv", 
                "shapiro",
                "--clustered",
                "--cols", "HiFreq", "Bndwdth"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: Normality shapiro-wilk no clusters",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/result_analysis/bat_measures_normality.py",
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures_augmented.csv", 
                "shapiro",
                "--cols", "HiFreq", "Bndwdth"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: Normality in clusters matrix",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/result_analysis/charting.py",
            "console": "integratedTerminal",
            "args": [
                "--normality_in_clusters",
                "${workspaceFolder}/src/result_analysis/data/bats_measures_normality_all.csv", 
                "--outdir", "${workspaceFolder}/src/result_analysis/data/AnalysisViz"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: Measure importance (KW and Random Forest)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/result_analysis/measures_in_clusters.py",
            "subProcess": false,
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures.csv",
                "--cols", "HiFreq", "Bndwdth",
                "--force"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: Visualize cluster profiles",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/result_analysis/viz_measures_in_clusters.py",
            "subProcess": false,
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures.csv",
                "${workspaceFolder}/src/result_analysis/data/barn_results/meas_towards_clusters_cluster_profiles.csv",
                "--illustrations", "tendency-heat"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: Visualize cluster histograms",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/result_analysis/viz_measures_in_clusters.py",
            "subProcess": false,
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures_scaled_robust.csv",
                "${workspaceFolder}/src/result_analysis/data/barn_results/meas_towards_clusters_cluster_profiles.csv",
                "--illustrations", "histograms",
                "--measure", "HiFtoKnAmp",
                "--clusters", "0", "1", "3"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: scaling to z-score",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/sonobat_utils/scaling.py",
            "subProcess": false,
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures.csv",
                "z-score",
                "--outfile", "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures_scaled_z_scores.csv",
                "--column", "TimeInFile", "PrecedingIntrvl", "HiFreq", "Bndwdth", "FreqMaxPwr", "PrcntMaxAmpDur", "FreqKnee", "PrcntKneeDur", "StartF", "UpprKnFreq", "HiFtoUpprKnAmp", "HiFtoKnAmp", "HiFtoFcAmp", "UpprKnToKnAmp", "KnToFcAmp", "LdgToFcAmp", "FreqCtr", "FFwd32dB", "FFwd20dB", "FFwd15dB", "FBak5dB", "FFwd5dB", "Bndw32dB", "Amp1stQrtl", "Amp2ndQrtl", "Amp3rdQrtl", "Amp4thQrtl", "1st10kHzSlp", "1st5to15kHzSlp", "1st10kHzExp", "1st5to15kHzExp", "AmpK@start"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: scaling to robust",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/sonobat_utils/scaling.py",
            "subProcess": false,
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures_augmented.csv",
                "robust",
                "--outfile", "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures_augmented_scaled_robust.csv",
                "--column", "TimeInFile", "PrecedingIntrvl", "HiFreq", "Bndwdth", "FreqMaxPwr", "PrcntMaxAmpDur", "FreqKnee", "PrcntKneeDur", "StartF", "UpprKnFreq", "HiFtoUpprKnAmp", "HiFtoKnAmp", "HiFtoFcAmp", "UpprKnToKnAmp", "KnToFcAmp", "LdgToFcAmp", "FreqCtr", "FFwd32dB", "FFwd20dB", "FFwd15dB", "FBak5dB", "FFwd5dB", "Bndw32dB", "Amp1stQrtl", "Amp2ndQrtl", "Amp3rdQrtl", "Amp4thQrtl", "1st10kHzSlp", "1st5to15kHzSlp", "1st10kHzExp", "1st5to15kHzExp", "AmpK@start"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: outlier detection",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/sonobat_utils/outlier_analysis.py",
            "subProcess": false,
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures.csv",
                "--sd-threshold", "1.0",
                "--ignore", "cluster", "file_id", "chirp_idx", "idiom_start", "idiom_end", "in_idiom"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: gather population: idiom_internal",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/sonobat_utils/data_selection.py",
            "subProcess": false,
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/src/result_analysis/data/andrewChen/analysis_results/2022_barn_2secs_myca_quantile_1_16/all_chirp_measures.csv",
                "--population_type", "non-idiom-random",
                "--rand_selector", "match-in-idiom"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: Run all analyses on a list of sub populations",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/result_analysis/run_analysis_per_subpopulation.py",
            "subProcess": false,
            "console": "integratedTerminal",
            "args": [
                "--force",
                "idiom-internal", "idiom-starts", "idiom-ends", "idiom-any", "non-idiom-random"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        },
        {
            "name": "Python: Chirp generation",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/chirp_gen/chirp_generation.py",
            "subProcess": false,
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/src/chirp_gen/test/20180714_Parameters_v4.4.5.tsv"
            ],
            "cwd": "${workspaceFolder}/src",
            "justMyCode": false
        }
    ],
    "debug.defaultConfiguration": "Python: Test Explorer (unittests)"
}
